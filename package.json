{
  "name": "image-converter",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "description": "Convert images app",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.js",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:build": "npm run icons && npm run build && electron-builder",
    "release": "npm run build && cross-env electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yoanmarchal/electron-image-converter.git"
  },
  "author": {
    "name": "Yoan Marchal",
    "email": "marchalyoan@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "electron",
    "image",
    "converter",
    "app"
  ],
  "dependencies": {
    "classnames": "^2.5.1",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "sharp": "^0.35.4",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "build": {
    "appId": "com.yoanmarchal.imageconverter",
    "productName": "Image Converter",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "squirrel"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "public/logo.svg",
      "maintainer": "Yoan Marchal <marchalyoan@gmail.com>",
      "vendor": "Yoan Marchal",
      "synopsis": "Convert and optimize images easily",
      "description": "A simple and efficient image converter supporting multiple formats including WebP, AVIF, JPEG, and PNG."
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.js",
      "!**/*.map"
    ],
    "publish": {
      "provider": "github",
      "owner": "yoanmarchal",
      "repo": "electron-image-converter"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "protocols": {
      "name": "Image Converter",
      "schemes": [
        "imageconverter"
      ]
    }
  }
}
